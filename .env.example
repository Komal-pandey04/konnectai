# ════════════════════════════════════════════════
#   KonnectAPI v2 — Environment Config
#   Uses HuggingFace Inference API for AI
# ════════════════════════════════════════════════

# Server
PORT=3000

# JWT — change this to a long random string in production!
JWT_SECRET=konnectapi-super-secret-jwt-key-change-me-in-production

# ── HuggingFace AI ───────────────────────────────
# Get your free token: https://huggingface.co/settings/tokens
# Choose "Read" access token (free tier works!)
HF_API_TOKEN= tokenkey

# Model to use — recommended options:
#   mistralai/Mistral-7B-Instruct-v0.3   ← default, great quality, free
#   HuggingFaceH4/zephyr-7b-beta         ← free, good responses
#   microsoft/Phi-3-mini-4k-instruct     ← fast & lightweight, free
#   meta-llama/Meta-Llama-3-8B-Instruct  ← best quality (needs HF Pro or approved access)
HF_MODEL=microsoft/Phi-3-mini-4k-instruct# ── Twilio SMS (optional) ────────────────────────
# Get credentials: https://console.twilio.com
# Leave blank to skip SMS — sensitive messages still stored in DB
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE=+1xxxxxxxxxx
KOMAL_PHONE=+91xxxxxxxxxx
